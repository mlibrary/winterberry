require 'csv'

lpp_csv_file_list.each do |lpp_csv_file|
  lpp_csv_file = File.expand_path(lpp_csv_file)
  unless File.file?(lpp_csv_file)
    script_logger.error("invalid LPP CSV file #{lpp_csv_file}")
    exit 1
  end
  script_logger.info("processing LPP CSV file #{File.basename(lpp_csv_file)}")

  lpp_csv = CSV.parse(
                        File.read(lpp_csv_file),
                        :headers => true,
                        :return_headers => false
                      )


  lpp_rep_csv_file = File.join(File.dirname(lpp_csv_file), File.basename(lpp_csv_file, ".*") + "_report.csv")
  CSV.open(
          lpp_rep_csv_file,
          "w",
          force_quotes: true,
          write_headers: true,
          headers: lpp_csv.headers + ["Exported?"]
        ) do |csv|
    row = {}
    lpp_csv.each do |lpp_row|
      nrow = {}
      lpp_row.each {|c,v| nrow[c] = v}
      nrow['Exported?'] = LPP_DOIs.include?(lpp_row['DOI'])
      csv << nrow
    end
  end
  script_logger.info("saved CSV file #{lpp_rep_csv_file}")
end
